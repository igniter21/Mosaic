MOSAIC_ENVIRONMENT=development
MOSAIC_DATA_DIR=./data
MOSAIC_FRONTEND_ORIGIN=http://localhost:3000

MOSAIC_COLLECTOR_ORIGINS=

MOSAIC_GEMINI_API_KEY=
MOSAIC_GEMINI_MODEL=gemini-3.6-flash

# Local semantic retrieval
MOSAIC_SEMANTIC_MODEL=sentence-transformers/all-MiniLM-L6-v2
MOSAIC_SEMANTIC_DEVICE=auto

# Automatically create semantic embeddings for newly created memories.
MOSAIC_AUTO_SEMANTIC_INDEX=true

# Privacy lifecycle
MOSAIC_AUTO_FORGET=false