MOSAIC_ENVIRONMENT=development
MOSAIC_DATA_DIR=./data
MOSAIC_FRONTEND_ORIGIN=http://localhost:3000

# Comma-separated browser-extension origins allowed to post to the local API.
# Add the ID Chrome shows for the unpacked Mosaic browser extension, for example:
# MOSAIC_COLLECTOR_ORIGINS=chrome-extension://abcdefghijklmnopabcdefghijklmnop
MOSAIC_COLLECTOR_ORIGINS=

# Optional click-only tab understanding. Keep the key in the local .env file.
MOSAIC_GEMINI_API_KEY=
MOSAIC_GEMINI_MODEL=gemini-3.6-flash
MOSAIC_SEMANTIC_MODEL=all-MiniLM-L6-v2
MOSAIC_AUTO_FORGET=false
